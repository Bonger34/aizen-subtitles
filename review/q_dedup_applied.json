 "retimed": [
  {
   "ep": "P02",
   "old_ts": "2m40s",
   "new_ts": "2m37s",
   "text": "你先冷静点"
  },
  {
   "ep": "P05",
   "old_ts": "3m31s",
   "new_ts": "3m29s",
   "text": "这东西可贵了"
  },
  {
   "ep": "P07",
   "old_ts": "14m35s",
   "new_ts": "14m30s",
   "text": "小牧姐小牧姐小牧姐你没事吧"
  },
  {
   "ep": "P07",
   "old_ts": "20m18s",
   "new_ts": "20m16s",
   "text": "烈火形态"
  },
  {
   "ep": "P07",
   "old_ts": "7m02s",
   "new_ts": "7m00s",
   "text": "哥哥你真是爱操心啊"
  },
  {
   "ep": "P07",
   "old_ts": "7m31s",
   "new_ts": "7m27s",
   "text": "哥哥你太过分了"
  },
  {
   "ep": "P07",
   "old_ts": "9m06s",
   "new_ts": "9m03s",
   "text": "一点也不好"
  },
  {
   "ep": "P08",
   "old_ts": "10m05s",
   "new_ts": "10m04s",
   "text": "好的吧"
  },
  {
   "ep": "P08",
   "old_ts": "7m56s",
   "new_ts": "7m52s",
   "text": "毕竟这上面就印了汗渍嘛"
  },
  {
   "ep": "P09",
   "old_ts": "10m58s",
   "new_ts": "11m00s",
   "text": "别让我们担心你"
  },
  {
   "ep": "P10",
   "old_ts": "12m34s",
   "new_ts": "12m33s",
   "text": "这样吧我有一个提案"
  },
  {
   "ep": "P10",
   "old_ts": "5m15s",
   "new_ts": "5m11s",
   "text": "也借我用一下嘛"
  },
  {
   "ep": "P10",
   "old_ts": "8m33s",
   "new_ts": "8m28s",
   "text": "玩得开心点吧"
  },
  {
   "ep": "P10",
   "old_ts": "8m40s",
   "new_ts": "8m41s",
   "text": "而且我们现在是凑勇海和凑活海"
  },
  {
   "ep": "P11",
   "old_ts": "10m10s",
   "new_ts": "10m06s",
   "text": "打败怪兽时的必杀技超帅"
  },
  {
   "ep": "P11",
   "old_ts": "18m01s",
   "new_ts": "18m02s",
   "text": "我不是说了不许你们再变身了吗"
  },
  {
   "ep": "P11",
   "old_ts": "7m15s",
   "new_ts": "7m10s",
   "text": "我们很担心你呢"
  },
  {
   "ep": "P12",
   "old_ts": "6m09s",
   "new_ts": "6m03s",
   "text": "这种时候我该做些什么呢小澪"
  },
  {
   "ep": "P13",
   "old_ts": "16m14s",
   "new_ts": "16m10s",
   "text": "毕竟小澪很怕羞"
  },
  {
   "ep": "P14",
   "old_ts": "10m09s",
   "new_ts": "10m07s",
   "text": "你说朋友为什么她会拿着水晶啊"
  },
  {
   "ep": "P14",
   "old_ts": "19m55s",
   "new_ts": "19m51s",
   "text": "怎么办哥哥"
  },
  {
   "ep": "P14",
   "old_ts": "21m20s",
   "new_ts": "21m17s",
   "text": "万一是陷阱呢"
  },
  {
   "ep": "P14",
   "old_ts": "5m16s",
   "new_ts": "5m12s",
   "text": "威廉·莎士比亚"
  },
  {
   "ep": "P14",
   "old_ts": "8m57s",
   "new_ts": "8m53s",
   "text": "小剑小剑"
  },
  {
   "ep": "P15",
   "old_ts": "22m19s",
   "new_ts": "22m17s",
   "text": "警方认为爱染社长可能被卷入了某起案件之中"
  },
  {
   "ep": "P15",
   "old_ts": "4m45s",
   "new_ts": "4m40s",
   "text": "你说什么你再说一遍"
  },
  {
   "ep": "P16",
   "old_ts": "0m39s",
   "new_ts": "0m36s",
   "text": "我是之前暂时失去了意识的爱染诚"
  },
  {
   "ep": "P16",
   "old_ts": "13m38s",
   "new_ts": "13m36s",
   "text": "可是小剑她"
  },
  {
   "ep": "P16",
   "old_ts": "14m45s",
   "new_ts": "14m42s",
   "text": "你这句话"
  },
  {
   "ep": "P16",
   "old_ts": "20m48s",
   "new_ts": "20m44s",
   "text": "照片算什么"
  },
  {
   "ep": "P17",
   "old_ts": "20m47s",
   "new_ts": "20m45s",
   "text": "竟然能够齐心协力"
  },
  {
   "ep": "P17",
   "old_ts": "5m23s",
   "new_ts": "5m20s",
   "text": "你要搞什么呀"
  },
  {
   "ep": "P18",
   "old_ts": "11m54s",
   "new_ts": "11m50s",
   "text": "好慢啊应该差不多要到了吧"
  },
  {
   "ep": "P18",
   "old_ts": "1m30s",
   "new_ts": "1m27s",
   "text": "广告之后"
  },
  {
   "ep": "P18",
   "old_ts": "5m54s",
   "new_ts": "5m50s",
   "text": "接下来我和你们说一下安排"
  },
  {
   "ep": "P18",
   "old_ts": "8m29s",
   "new_ts": "8m25s",
   "text": "下周播出下半集"
  },
  {
   "ep": "P18",
   "old_ts": "9m41s",
   "new_ts": "9m39s",
   "text": "制作T恤也是为了隐居"
  },
  {
   "ep": "P19",
   "old_ts": "9m41s",
   "new_ts": "9m40s",
   "text": "关闭系统"
  },
  {
   "ep": "P20",
   "old_ts": "17m49s",
   "new_ts": "17m44s",
   "text": "这可不得了"
  },
  {
   "ep": "P20",
   "old_ts": "21m34s",
   "new_ts": "21m32s",
   "text": "快下决心吧"
  },
  {
   "ep": "P20",
   "old_ts": "21m51s",
   "new_ts": "21m48s",
   "text": "哥哥你的斗志呢"
  },
  {
   "ep": "P20",
   "old_ts": "6m51s",
   "new_ts": "6m44s",
   "text": "之前我就觉得她不是个普通的女孩子"
  },
  {
   "ep": "P20",
   "old_ts": "8m20s",
   "new_ts": "8m18s",
   "text": "朝阳这个借我一下吧"
  },
  {
   "ep": "P21",
   "old_ts": "16m33s",
   "new_ts": "16m31s",
   "text": "嗯我明白了"
  },
  {
   "ep": "P21",
   "old_ts": "16m41s",
   "new_ts": "16m39s",
   "text": "不我说谎了"
  },
  {
   "ep": "P25",
   "old_ts": "15m47s",
   "new_ts": "15m44s",
   "text": "我就是那时候诞生的"
  },
  {
   "ep": "P05",
   "old_ts": "9m50s",
   "new_ts": "9m48s",
   "text": "那么那个"
  },
  {
   "ep": "P05",
   "old_ts": "9m51s",
   "new_ts": "9m49s",
   "text": "我回来了"
  }
